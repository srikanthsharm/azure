trigger:
- main

pool:
  vmImage: 'ubuntu-latest'  # Agent to run the build [citation:4][citation:5]

variables:
  # --- IMPORTANT: Replace these values ---
  azureSubscription: 'your-azure-service-connection'  # Name of your service connection in Azure DevOps
  appName: 'your-webapp-name'                         # Name of your Web App in Azure
  containerRegistry: 'your-acr-name.azurecr.io'       # Full login server of your ACR
  dockerRegistryServiceConnection: 'your-acr-service-connection' # ACR service connection name
  imageRepository: 'your-image-repo-name'              # Repository name in ACR
  tag: '$(Build.BuildId)'                              # Unique tag for each build
  # ----------------------------------------

  dockerfilePath: '**/Dockerfile'                      # Path to your Dockerfile
  vmImageName: 'ubuntu-latest'                         # Agent for the deployment job

stages:
- stage: Build
  displayName: 'Build and Push Stage'
  jobs:
  - job: Build
    displayName: 'Build'
    pool:
      vmImage: $(vmImageName)
    steps:
    - checkout: self

    # Task 1: Build the Java application with Maven
    - task: Maven@4
      displayName: 'Build with Maven'
      inputs:
        mavenPomFile: 'pom.xml'
        mavenOptions: '-Xmx3072m'
        javaHomeOption: 'JDKVersion'
        jdkVersionOption: '1.17'          # Or your required JDK version [citation:4][citation:6]
        jdkArchitectureOption: 'x64'
        publishJUnitResults: true
        testResultsFiles: '**/surefire-reports/TEST-*.xml'
        goals: 'clean package'             # Standard Maven build command [citation:8]

    # Task 2: Build and push Docker image to Azure Container Registry
    - task: Docker@2
      displayName: 'Build and Push Image to ACR'
      inputs:
        command: 'buildAndPush'
        containerRegistry: $(dockerRegistryServiceConnection)
        repository: $(imageRepository)
        dockerfile: $(dockerfilePath)
        tags: |
          $(tag)
          latest

- stage: Deploy
  displayName: 'Deploy to Azure App Service'
  jobs:
  - deployment: Deploy
    displayName: 'Deploy to Web App'
    pool:
      vmImage: $(vmImageName)
    environment: '$(appName)-environment'    # Creates an environment for tracking [citation:1]
    strategy:
      runOnce:
        deploy:
          steps:
          # Task 3: Deploy the container image to Azure Web App
          - task: AzureWebAppContainer@1
            displayName: 'Deploy Container to App Service'
            inputs:
              azureSubscription: $(azureSubscription)
              appName: $(appName)
              containers: $(containerRegistry)/$(imageRepository):$(tag)
